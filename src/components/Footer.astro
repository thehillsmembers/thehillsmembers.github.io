---
// The footer: three short notes on Linho, the newsletter on Sálvia, then Noite with the wordmark
// in Ouro, four columns of links, and a last line with the city, Instagram and the year.
import Newsletter from './Newsletter.astro';
import { applyLink, copy, link, site, to } from '../lib/content';
const t = copy('en');
const f = t.footer;
type L = { label: string; href: string };
const notes = t.prefooter as { title: string; text: string; link: string; href: string }[];
const columns = f.columns as { title: string; links: L[] }[];
const year = new Date().getFullYear();
// "Apply" scrolls to the form when it is on the same page
const go = (href: string) => (href === '/apply/' ? applyLink(Astro.url.pathname) : to(href));
---
<footer class="site-footer">
  <div class="notes">
    <div class="wrap notes-grid">
      {notes.map((n) => (
        <div class="note">
          <h2 class="label">{n.title}</h2>
          <p>{n.text}</p>
          <a class="cta" href={go(n.href)}>{n.link}</a>
        </div>
      ))}
    </div>
  </div>

  <Newsletter />

  <div class="dark">
    <div class="wrap">
      <a class="logo" href={link('/')} aria-label={t.nav.home}>
        <img src={link('/brand/wordmark-ouro.svg')} alt="" width="4640" height="1191" loading="lazy" decoding="async" />
      </a>
      <nav class="cols" aria-label="Footer">
        {columns.map((c) => (
          <div class="col">
            <h2 class="col-title">{c.title}</h2>
            <ul>
              {c.links.map((l) => <li><a href={go(l.href)}>{l.label}</a></li>)}
            </ul>
          </div>
        ))}
      </nav>
      <div class="bottom">
        <p>{f.city}</p>
        <a class="icon-button ig" href={site.instagramUrl} rel="noopener" aria-label={`Instagram, ${site.instagramHandle}`}>
          <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.75" y="2.75" width="14.5" height="14.5" rx="4" /><circle cx="10" cy="10" r="3.4" /><circle class="dot" cx="14.5" cy="5.5" r="0.9" /></svg>
        </a>
        <p>© <span data-year>{year}</span> Seven Hills</p>
      </div>
    </div>
  </div>
</footer>
<script is:inline>document.querySelectorAll('[data-year]').forEach(function (el) { el.textContent = new Date().getFullYear(); });</script>

<style>
  /* ── Three notes on Linho: stacked with hairlines on phones, three columns on wide screens ── */
  .notes { border-top: 1px solid var(--line); }
  .note {
    display: grid;
    gap: 0.45rem;
    justify-items: start;
    align-content: start;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .note:last-child { border-bottom: 0; padding-bottom: 2.25rem; }
  .note p { color: var(--muted); max-width: 34ch; }
  @media (min-width: 48rem) {
    .notes-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gap);
      padding-block: clamp(2.5rem, 5vw, 3.75rem);
    }
    .note,
    .note:last-child { padding-block: 0; border-bottom: 0; }
  }

  /* ── Noite ── */
  .dark {
    background: var(--noite);
    color: var(--linho);
    padding-block: 3.5rem calc(1.5rem + env(safe-area-inset-bottom));
  }
  .logo { display: block; width: fit-content; margin-inline: auto; }
  .logo img { width: 12.15rem; height: auto; }

  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem var(--gap);
    margin-top: 3rem;
  }
  .col-title {
    margin-bottom: 0.6rem;
    font-size: 0.75rem;
    line-height: 1.5;
    font-weight: 600;
    font-stretch: var(--wide);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .col a {
    display: inline-block;
    padding-block: 0.3rem;
    color: #a5a098; /* Linho at 64% on Noite: 7:1 */
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .col a:focus-visible { color: var(--linho); }
  @media (hover: hover) {
    .col a:hover { color: var(--linho); }
  }

  .bottom {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #373632;
    color: #a5a098;
    font-size: 0.75rem;
    text-align: center;
  }
  .ig { color: #a5a098; }
  .ig svg .dot { fill: currentColor; stroke: none; }
  @media (min-width: 48rem) {
    .cols { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 3.5rem; }
    .bottom { grid-template-columns: 1fr auto 1fr; align-items: center; }
    .bottom p:first-child { justify-self: start; }
    .bottom p:last-child { justify-self: end; }
  }
</style>

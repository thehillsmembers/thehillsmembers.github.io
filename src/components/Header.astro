---
// The header, in the manner of a maison's website. It stays at the top of the screen:
// - a thin Noite line, then a bar with the wordmark in the middle. On phones: the menu and
//   Instagram on the left, Apply on the right. On wide screens: Instagram and Apply on the right,
// - on wide screens, a centred row of links underneath, which folds away once the page scrolls.
// The Agenda link only shows while there are upcoming dates. data-agenda-until carries the last
// one, so the script can drop the link once that day has passed.
import { applyLink, copy, link, site, upcoming } from '../lib/content';
const t = copy('en');
const events = upcoming();
type Link = { label: string; href: string };
const links = (t.nav.links as Link[]).filter((l) => events.length > 0 || !l.href.endsWith('#agenda'));
const agendaUntil = events.length ? events[events.length - 1].date : undefined;
const apply = applyLink(Astro.url.pathname);
const igLabel = `Instagram, ${site.instagramHandle}`;
---
<header class="site-header" data-header data-agenda-until={agendaUntil}>
  <div class="wrap bar">
    <div class="bar-start">
      <details class="menu" data-menu>
        <summary class="icon-button menu-toggle">
          <span class="visually-hidden">{t.nav.menu}</span>
          <svg class="i-open" viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 5.5h15M2.5 10h15M2.5 14.5h15" /></svg>
          <svg class="i-close" viewBox="0 0 20 20" aria-hidden="true"><path d="m4.5 4.5 11 11m0-11-11 11" /></svg>
        </summary>
        <nav class="menu-panel" aria-label="Main">
          <ul>
            {links.map((l) => <li><a href={link(l.href)}>{l.label}</a></li>)}
            <li><a href={apply}>{t.nav.apply}</a></li>
            <li><a href={site.instagramUrl} rel="noopener">Instagram</a></li>
          </ul>
        </nav>
      </details>
      <a class="icon-button ig ig-phone" href={site.instagramUrl} rel="noopener" aria-label={igLabel}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.75" y="2.75" width="14.5" height="14.5" rx="4" /><circle cx="10" cy="10" r="3.4" /><circle class="dot" cx="14.5" cy="5.5" r="0.9" /></svg>
      </a>
    </div>

    <a class="home" href={link('/')} aria-label={t.nav.home}>
      <img src={link('/brand/wordmark-noite.svg')} alt="" width="4640" height="1191" />
    </a>

    <div class="bar-end">
      <a class="icon-button ig ig-wide" href={site.instagramUrl} rel="noopener" aria-label={igLabel}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.75" y="2.75" width="14.5" height="14.5" rx="4" /><circle cx="10" cy="10" r="3.4" /><circle class="dot" cx="14.5" cy="5.5" r="0.9" /></svg>
      </a>
      <a class="apply" href={apply}>{t.nav.apply}</a>
    </div>
  </div>

  <nav class="nav-row" aria-label="Main">
    <ul class="wrap">
      {links.map((l) => <li><a href={link(l.href)}>{l.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    background: var(--linho);
    border-top: var(--top-h) solid var(--noite);
  }

  /* ── The bar ── */
  .bar {
    height: var(--bar-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }
  .bar-start { display: flex; align-items: center; margin-left: -0.7rem; }
  .bar-end { display: flex; align-items: center; justify-content: flex-end; gap: 0.25rem; }
  /* the logo file has clear space around the letters, about 7px on phones */
  .home { display: block; margin-inline: -0.4rem; padding-block: 0.25rem; }
  .home img { width: 8.29rem; height: auto; }

  .ig svg .dot { fill: currentColor; stroke: none; }
  .ig-wide { display: none; }

  .apply {
    display: block;
    padding: 0.85rem 0 0.85rem 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    font-stretch: var(--wide);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }
  @media (hover: hover) {
    .apply:hover { text-decoration: underline; text-underline-offset: 0.35em; }
  }

  /* ── Phone menu: a panel under the bar, over the page ── */
  .menu-toggle { list-style: none; }
  .menu-toggle::-webkit-details-marker { display: none; }
  .i-close,
  .menu[open] .i-open { display: none; }
  .menu[open] .i-close { display: block; }
  .menu-panel {
    position: fixed;
    inset: calc(var(--top-h) + var(--bar-h)) 0 0;
    z-index: 2;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--linho);
    border-top: 1px solid var(--line);
    padding: 0.5rem var(--gutter) calc(2.5rem + env(safe-area-inset-bottom));
  }
  .menu-panel a {
    display: block;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.8125rem;
    font-weight: 600;
    font-stretch: var(--wide);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  /* ── The row of links (wide screens) ── */
  .nav-row { display: none; }

  @media (min-width: 64rem) {
    .bar-start { margin-left: 0; }
    .menu,
    .ig-phone { display: none; }
    .ig-wide { display: inline-grid; }
    .home img { width: 12.15rem; }

    .nav-row {
      display: block;
      height: var(--nav-h);
      overflow: hidden;
      transition: height 0.45s var(--ease), visibility 0s;
    }
    .nav-row ul {
      height: var(--nav-h);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: clamp(1.75rem, 3vw, 3rem);
    }
    .nav-row a {
      display: block;
      padding-block: 0.8rem;
      font-size: 0.75rem;
      font-weight: 600;
      font-stretch: var(--wide);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      background: linear-gradient(currentColor, currentColor) no-repeat 50% calc(100% - 0.55rem) / 0 1px;
      transition: background-size 0.35s var(--ease);
    }
    .nav-row a:hover,
    .nav-row a:focus-visible { background-size: 100% 1px; }
    /* once the page scrolls, only the bar stays */
    .site-header.is-folded .nav-row {
      height: 0;
      visibility: hidden;
      transition: height 0.45s var(--ease), visibility 0s linear 0.45s;
    }
  }
</style>

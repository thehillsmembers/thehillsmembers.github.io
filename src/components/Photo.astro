---
// A photo from src/assets/photos, cropped to the shape of its place: `ratio`, and `mobileRatio`
// on phones. The file is named after the place (hero.jpg, table-of-seven.jpg…; .jpg, .png or
// .webp) and its description for screen readers is in content/site.yaml, under photos.
// Each photo is resized into several widths, so a phone only downloads what its screen needs.
//
// While a photo is missing, a numbered box stands in for it, so the layout can be judged with
// `npm run dev`. The real build (the one that publishes the site) stops with an error while any
// photo or description is missing, so a placeholder can never go live.
// For a local test build only: ALLOW_PLACEHOLDERS=1 npm run build
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { site } from '../lib/content';

interface Props {
  name: string;
  ratio: string;
  mobileRatio?: string;
  sizes: string;
  eager?: boolean;
  /** Where the crop centres, e.g. "50% 30%" to keep faces near the top in view. Without it,
   *  photo_focus in content/site.yaml decides (top, bottom, left, right or two numbers like that),
   *  else the middle. */
  position?: string;
  class?: string;
  [attribute: `data-${string}`]: unknown;
}

const { name, ratio, mobileRatio, sizes, eager = false, position, class: className, ...rest } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const file = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase() === name);
const image = file?.[1].default;
const alt = (site.photos[name] ?? '').trim();
const places = Object.keys(site.photos);
const number = places.includes(name) ? places.indexOf(name) + 1 : '+';

if (import.meta.env.PROD && !process.env.ALLOW_PLACEHOLDERS) {
  if (!image) throw new Error(`Photo ${number} is missing: add src/assets/photos/${name}.jpg before publishing.`);
  if (!alt) throw new Error(`Photo "${name}" has no description: write one under photos in content/site.yaml.`);
}

const widths = image ? [...new Set([480, 800, 1200, 1600, 2000].filter((w) => w < image.width).concat(Math.min(image.width, 2000)))] : [];
const shape = (r: string) => r.replace(/\s/g, '');
const sides: Record<string, string> = { top: '50% 0%', bottom: '50% 100%', left: '0% 50%', right: '100% 50%' };
const focus = (position ?? site.photoFocus[name] ?? '').trim();
const objectPosition = sides[focus] ?? focus;
---
<div {...rest} class:list={['photo', className, { 'is-empty': !image }]} style={`--ratio: ${ratio}; --ratio-m: ${mobileRatio ?? ratio}`}>
  {image ? (
    <Picture
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['webp']}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
      style={objectPosition ? `object-position: ${objectPosition}` : undefined}
    />
  ) : (
    <p class="photo-label" aria-hidden="true">
      {number} · {name.replace(/-/g, ' ')}<br />
      {shape(ratio)}{mobileRatio && mobileRatio !== ratio ? ` · ${shape(mobileRatio)} on phones` : ''}
    </p>
  )}
</div>

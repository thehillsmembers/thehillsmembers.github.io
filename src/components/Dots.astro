---
// The Line: seven dots, seven hills. For the agenda and routes.
// The dots and the line are real elements so the motion script can light them in sequence.
interface Props { color?: string; class?: string }
const { color = 'var(--lima)', class: className } = Astro.props;
---
<div class:list={['dots', className]} style={`--dot:${color}`} aria-hidden="true" data-dots>
  <i class="dots-line"></i>
  {Array.from({ length: 7 }, () => <span class="dot"></span>)}
</div>

<style>
  .dots {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--dot-size, 14px);
  }
  .dots-line {
    position: absolute;
    inset-inline: calc(var(--dot-size, 14px) / 2);
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    opacity: 0.35;
    transform-origin: left;
  }
  .dot {
    position: relative;
    width: var(--dot-size, 14px);
    height: var(--dot-size, 14px);
    border-radius: 50%;
    background: var(--dot);
  }
</style>

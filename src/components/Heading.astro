---
// A big serif heading made of stacked lines. *word* becomes italic.
// Each line slides up into place when it scrolls into view (see scripts/motion.ts).
import { rich } from '../lib/content';
interface Props { lines: string[]; as?: 'h1' | 'h2' | 'h3'; size?: 1 | 2; class?: string; id?: string }
const { lines, as: Tag = 'h2', size = 1, class: className, id } = Astro.props;
---
<Tag id={id} class:list={['display', { 'display-2': size === 2 }, className]} data-lines>
  {lines.map((l) => <span class="line"><span set:html={rich(l)} /></span>)}
</Tag>

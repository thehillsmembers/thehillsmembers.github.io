---
import Base from '../layouts/Base.astro';
import Heading from '../components/Heading.astro';
import { copy, site, upcoming, shortDate, rich, link } from '../lib/content';

const t = copy('en');
const events = upcoming();
const pad = (n: number) => String(n).padStart(2, '0');

type Item = { name: string; line: string };
const experiences = t.experiences.items as Item[];

// "Lisboa → London", with the last city in italic
const cities = site.cities;
const routeLine = cities.map((c, i) => (i === cities.length - 1 && i > 0 ? `*${c}*` : c)).join(' → ');

// The seal's ring of text, repeated so it closes neatly around the circle
const sealText = `${t.hero.seal} · `.toUpperCase();
---
<Base>
  <!-- 1 · HERO · Linho -->
  <section class="hero" aria-label="Seven Hills">
    <div class="wrap hero-inner">
      <Heading as="h1" lines={t.hero.lines} class="hero-title" />
      <div class="hero-foot">
        <div class="hero-intro" data-enter>
          {t.hero.intro.map((p: string) => <p class="intro">{p}</p>)}
        </div>
        <div class="seal" data-enter style="--delay: 0.9s" aria-hidden="true">
          <svg class="seal-ring" viewBox="0 0 200 200" focusable="false">
            <defs><path id="seal-path" d="M 100,100 m -79,0 a 79,79 0 1,1 158,0 a 79,79 0 1,1 -158,0" /></defs>
            <text><textPath href="#seal-path" textLength="496" lengthAdjust="spacing">{sealText}</textPath></text>
          </svg>
          <img class="seal-mono" src={link('/brand/monogram-noite.png')} alt="" width="889" height="921" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · THE CIRCLE · Noite -->
  <section id="circle" class="section circle theme-noite" aria-labelledby="circle-title">
    <div class="wrap grid">
      <p class="label" data-reveal>{t.circle.label}</p>
      <Heading id="circle-title" lines={t.circle.lines} flow />
      <div class="right circle-text" data-reveal>
        <p class="lead">{t.circle.text}</p>
        <p class="label values">{t.circle.values}</p>
      </div>
    </div>
  </section>

  <!-- 3 · EXPERIENCES · Linho: a full-width editorial list -->
  <section id="experiences" class="section experiences" aria-labelledby="exp-title">
    <div class="wrap">
      <div class="exp-head">
        <p class="label" data-reveal>{t.experiences.label}</p>
        <Heading id="exp-title" lines={t.experiences.lines} flow />
      </div>
      <ol class="exp-list">
        {experiences.map((e, i) => (
          <li class="exp-row" data-row>
            <span class="rule" aria-hidden="true"></span>
            <span class="num exp-num">{pad(i + 1)}</span>
            <h3 class="exp-name"><span>{e.name}</span></h3>
            <p class="exp-line">{e.line}</p>
            {i === experiences.length - 1 && <span class="rule rule-end" aria-hidden="true"></span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4 · AGENDA · Noite. Only there while content/site.yaml has upcoming dates. -->
  {events.length > 0 && (
    <section id="agenda" class="section agenda theme-noite" aria-labelledby="agenda-title" data-agenda>
      <div class="wrap grid">
        <div class="agenda-head">
          <p class="label" data-reveal>{t.agenda.label}</p>
          <Heading id="agenda-title" lines={t.agenda.lines} flow />
        </div>
        <div class="agenda-body">
          <ol class="events">
            {events.map((e) => (
              <li class="event" data-event-date={e.date} data-reveal>
                <time class="event-date" datetime={e.date}>{shortDate(e.date)}</time>
                <div class="event-main">
                  <p class="event-format">
                    {e.format}{e.edition ? <span class="event-ed"> Nº {e.edition}</span> : null}
                  </p>
                  {e.note && <p class="event-note">{e.note}</p>}
                  <p class="event-meta">
                    <span>{[e.weekday, e.time ? String(e.time).replace(':', 'H') : null, e.city].filter(Boolean).join(' · ')}</span>
                    <span>{t.agenda.location_note}</span>
                  </p>
                </div>
              </li>
            ))}
          </ol>
          <p class="follow" data-reveal>
            {t.agenda.follow} · <a class="link is-underlined" href={site.instagramUrl} rel="noopener">{site.instagramHandle}</a>
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- 5 · CITIES · Areia: one line -->
  <section class="section cities theme-areia" aria-labelledby="cities-title">
    <div class="wrap cities-inner">
      <p class="label" data-reveal>{t.cities.label}</p>
      <h2 id="cities-title" class="heading cities-line" data-split set:html={rich(routeLine)} />
      <p class="intro more" data-reveal>{t.cities.more}</p>
    </div>
  </section>

  <!-- 6 · HOW TO JOIN · Sálvia -->
  <section id="join" class="section join theme-salvia" aria-labelledby="join-title">
    <div class="wrap grid">
      <h2 id="join-title" class="label" data-reveal>{t.join.label}</h2>
      <ol class="steps">
        {t.join.steps.map((s: Item, i: number) => (
          <li class="step" data-reveal>
            <span class="num step-num">{pad(i + 1)}</span>
            <h3 class="step-name">{s.name}</h3>
            <p class="step-line">{s.line}</p>
          </li>
        ))}
      </ol>
      <div class="join-close">
        <Heading as="p" lines={t.join.lines} flow breaks class="join-line" />
        <a class="circle-button join-apply" href={link('/apply/')} data-reveal>{t.join.cta}</a>
      </div>
    </div>
  </section>

  <!-- 7 · PARTNERS · Linho -->
  <section id="partners" class="section partners" aria-labelledby="partners-title">
    <div class="wrap grid">
      <p class="label" data-reveal>{t.partners.label}</p>
      <Heading id="partners-title" lines={t.partners.lines} flow />
      <div class="right partners-body">
        <ul class="types">
          {t.partners.types.map((p: Item) => (
            <li data-reveal>
              <h3 class="label">{p.name}</h3>
              <p>{p.line}</p>
            </li>
          ))}
        </ul>
        <a class="link is-underlined partners-cta" href={link('/partners/')} data-reveal>{t.partners.cta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .label { margin-bottom: clamp(1.25rem, 3vw, 2rem); }

  /* 1 · Hero: the giant headline up top, the intro and the seal along the bottom */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding-block: calc(var(--header-h) + clamp(2rem, 6vw, 4rem)) clamp(1.75rem, 4vw, 3rem);
  }
  .hero-inner { flex: 1; display: flex; flex-direction: column; justify-content: space-between; gap: clamp(3rem, 9vw, 6rem); }
  .hero :global(.hero-title) { color: var(--salvia); }
  .hero-foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: end;
  }
  .hero-intro { grid-column: 1 / span 8; }
  .hero-intro p { text-wrap: balance; }
  .seal {
    grid-column: 9 / -1;
    justify-self: end;
    display: grid;
    place-items: center;
    width: clamp(5.75rem, 4.5rem + 4vw, 8.75rem);
    aspect-ratio: 1;
  }
  .seal > * { grid-area: 1 / 1; }
  .seal-ring { width: 100%; height: 100%; overflow: visible; animation: spin 60s linear infinite; }
  .seal-ring text { font-family: var(--font-black); font-size: 13.5px; fill: var(--noite); }
  .seal-mono { width: 30%; height: auto; }

  /* 2 · Circle: on Noite */
  .circle-text { margin-top: clamp(3rem, 7vw, 5.5rem); display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .lead { font-family: var(--font-display); font-size: clamp(1.65rem, 1.15rem + 1.6vw, 2.65rem); line-height: 1.12; max-width: 24ch; }
  .values { margin: 0; line-height: 2; max-width: 34rem; }

  /* 3 · Experiences: five rows, thin rules */
  .exp-head { margin-bottom: clamp(3rem, 7vw, 5.5rem); }
  .exp-row {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding-block: 1.5rem 1.75rem;
  }
  .rule {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: currentColor;
    transform-origin: left center;
  }
  .rule-end { inset: auto 0 0; }
  .exp-num { font-size: var(--size-label); letter-spacing: 0.12em; }
  .exp-name { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 0.95rem + 3.3vw, 4.25rem); line-height: 1; }
  .exp-name span { position: relative; display: inline-block; transition: transform 0.7s var(--ease); }
  /* the small Ouro dot that appears where the name was */
  .exp-name span::before {
    content: '';
    position: absolute;
    left: -1.35rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: -0.2rem;
    border-radius: 50%;
    background: var(--ouro);
    transform: scale(0);
    transition: transform 0.5s var(--ease);
  }
  .exp-line { max-width: 34ch; }
  @media (min-width: 48rem) {
    .exp-row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: baseline;
      padding-block: clamp(1.6rem, 2.8vw, 2.4rem);
    }
    .exp-num { grid-column: 1 / span 1; }
    .exp-name { grid-column: 2 / span 6; }
    .exp-line { grid-column: 8 / -1; max-width: none; font-size: 0.95rem; }
  }
  @media (hover: hover) and (min-width: 48rem) {
    .exp-row:hover .exp-name span { transform: translateX(1.9rem); }
    .exp-row:hover .exp-name span::before { transform: scale(1); }
  }

  /* 4 · Agenda: on Noite, heading on the left, dates on the right */
  .agenda-body { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .events { border-top: 1px solid color-mix(in srgb, var(--linho) 28%, transparent); }
  .event {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--linho) 28%, transparent);
  }
  .event-date { font-family: var(--font-display); font-size: clamp(2.1rem, 1.6rem + 1.6vw, 3.25rem); line-height: 1; color: var(--ouro); }
  .event-format { font-family: var(--font-display); font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.5rem); line-height: 1.05; }
  .event-ed { font-family: var(--font-black); font-size: var(--size-label); letter-spacing: 0.12em; vertical-align: middle; color: var(--ouro); }
  .event-note { margin-top: 0.5rem; max-width: 36ch; }
  .event-meta { display: grid; gap: 0.1rem; margin-top: 0.6rem; font-size: 0.9rem; }
  .follow { margin-top: 2rem; font-size: 0.95rem; }
  @media (min-width: 48rem) {
    .agenda-head { grid-column: 1 / span 6; align-self: start; position: sticky; top: calc(var(--header-h) + 2.5rem); }
    .agenda-body { grid-column: 7 / -1; margin-top: 0; }
    .event { grid-template-columns: 7rem minmax(0, 1fr); padding-block: 1.75rem; }
  }

  /* 5 · Cities: on Areia, one centred line */
  .cities { padding-block: clamp(7rem, 15vw, 12.5rem); }
  .cities-inner { display: grid; justify-items: center; text-align: center; }
  .more { margin-top: clamp(1.75rem, 4vw, 2.5rem); }

  /* 6 · Join: on Sálvia. Large type in Linho, small type in Noite. */
  .steps { display: grid; gap: 2.25rem; }
  .step { display: grid; gap: 0.5rem; padding-top: 1.25rem; border-top: 1px solid var(--linho); }
  .step-num { font-size: 1.6rem; line-height: 1; margin-bottom: 0.9rem; color: var(--linho); }
  .step-name { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.9rem, 1.45rem + 1.3vw, 2.75rem); line-height: 1; color: var(--linho); text-wrap: balance; }
  .step-line { max-width: 30ch; }
  .join-close { margin-top: clamp(4.5rem, 11vw, 8.5rem); display: grid; gap: 2.25rem; justify-items: start; }
  .join :global(.join-line) { color: var(--linho); }
  .join-apply { --circle: 7.5rem; }
  @media (min-width: 48rem) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--col-gap); }
    .join-close { grid-template-columns: 1fr auto; align-items: end; }
    .join-apply { --circle: 9.5rem; }
  }

  /* 7 · Partners: on Linho */
  .partners-body { margin-top: clamp(3rem, 7vw, 5rem); display: grid; gap: 2rem; justify-items: start; }
  .types { width: 100%; border-top: 1px solid var(--noite); }
  .types li { display: grid; gap: 0.25rem; padding-block: 1.1rem; border-bottom: 1px solid var(--noite); }
  .types .label { margin: 0; }
  .partners-cta { font-family: var(--font-display); font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem); line-height: 1.1; }
  @media (min-width: 48rem) {
    .types li { grid-template-columns: 9rem 1fr; align-items: baseline; }
  }

  @media (min-width: 48rem) {
    .hero-intro { grid-column: 5 / span 4; }
    .seal { grid-column: 10 / -1; }
  }
</style>

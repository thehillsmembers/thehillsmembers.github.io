---
import Base from '../layouts/Base.astro';
import Heading from '../components/Heading.astro';
import Dots from '../components/Dots.astro';
import { copy, site, upcoming, shortDate, image, rich, link } from '../lib/content';

const t = copy('en');
const heroImg = image(t.hero.image);
const events = upcoming();
const pad = (n: number) => String(n).padStart(2, '0');

type Exp = { name: string; line: string; image?: string; alt?: string };
const experiences = (t.experiences.items as Exp[]).map((e) => ({ ...e, src: image(e.image) }));

type Pic = { file: string; alt: string };
const agendaPics = (t.agenda.images as Pic[]).map((p) => ({ ...p, src: image(p.file) }));
const [lowPic, highPic] = agendaPics;

// "Lisboa → London", with the last city in italic
const cities = site.cities;
const routeLine = cities.map((c, i) => (i === cities.length - 1 && i > 0 ? `*${c}*` : c)).join(' → ');
const cityPos = cities.map((c, i) => ({ name: c, pos: cities.length > 1 ? Math.round((i / (cities.length - 1)) * 6) : 0 }));
---
<Base>
  <!-- 1 · HERO -->
  <section class="hero" aria-label="Seven Hills">
    <div class="wrap grid">
      <Heading as="h1" lines={t.hero.lines} class="hero-title" />
      <div class="hero-intro" data-reveal>
        {t.hero.intro.map((p: string) => <p class="intro">{p}</p>)}
      </div>
      {heroImg && (
        <figure class="hero-photo" data-zoom>
          <img src={heroImg} alt={t.hero.alt} fetchpriority="high" decoding="async" width="1600" height="1200" />
        </figure>
      )}
    </div>
  </section>

  <!-- 2 · THE CIRCLE -->
  <section id="circle" class="section circle" aria-labelledby="circle-title">
    <div class="wrap grid">
      <p class="label" data-reveal>{t.circle.label}</p>
      <Heading id="circle-title" lines={t.circle.lines} class="circle-title" />
      <div class="right circle-text" data-reveal>
        <p class="lead">{t.circle.text}</p>
        <p class="label values">{t.circle.values}</p>
      </div>
    </div>
  </section>

  <!-- 3 · EXPERIENCES: horizontal slider -->
  <section id="experiences" class="section experiences" aria-labelledby="exp-title">
    <div class="wrap grid">
      <p class="label" data-reveal>{t.experiences.label}</p>
      <Heading id="exp-title" lines={t.experiences.lines} size={2} />
    </div>
    <div class="slider" data-slider>
      <ul class="slides" data-slides tabindex="0" aria-label={t.experiences.label}>
        {experiences.map((e, i) => (
          <li class:list={['card', { 'no-img': !e.src }]}>
            {e.src && (
              <figure class="card-photo">
                <img src={e.src} alt={e.alt ?? ''} loading="lazy" decoding="async" draggable="false" width="900" height="1200" />
              </figure>
            )}
            <p class="num card-num">{pad(i + 1)}</p>
            <h3 class="card-name">{e.name}</h3>
            <p class="card-line">{e.line}</p>
          </li>
        ))}
      </ul>
      <div class="slider-nav" data-slider-nav>
        <button type="button" class="arrow" data-prev aria-label={t.experiences.previous}>←</button>
        <button type="button" class="arrow" data-next aria-label={t.experiences.next}>→</button>
      </div>
    </div>
  </section>

  <!-- 4 · AGENDA -->
  <section id="agenda" class="section agenda" aria-labelledby="agenda-title">
    <div class="wrap grid agenda-top">
      <div class="agenda-head">
        <p class="label" data-reveal>{t.agenda.label}</p>
        <Heading id="agenda-title" lines={t.agenda.lines} size={2} />
      </div>
      {highPic?.src && (
        <figure class="pic pic-high" data-zoom><img src={highPic.src} alt={highPic.alt} loading="lazy" decoding="async" width="900" height="1200" /></figure>
      )}
      {lowPic?.src && (
        <figure class="pic pic-low" data-zoom><img src={lowPic.src} alt={lowPic.alt} loading="lazy" decoding="async" width="1200" height="900" /></figure>
      )}
    </div>
    <div class="wrap grid">
      <div class="right-wide agenda-list">
        {events.length > 0 ? (
          <ol class="rows">
            {events.map((e) => (
              <li class="row" data-reveal>
                <time class="num row-date" datetime={e.date}>{shortDate(e.date)}</time>
                <p class="row-format">
                  {e.format}{e.edition ? <span class="row-ed"> Nº {e.edition}</span> : null}
                </p>
                <p class="row-meta">
                  <span>{[e.weekday, e.time ? String(e.time).replace(':', 'H') : null, e.city].filter(Boolean).join(' · ')}</span>
                  <span>{t.agenda.location_note}</span>
                </p>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty" data-reveal>{t.agenda.empty}</p>
        )}
        <p class="follow" data-reveal>
          {t.agenda.follow} · <a class="link is-underlined" href={site.instagramUrl} rel="noopener">{site.instagramHandle}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 5 · CITIES -->
  <section class="section cities" aria-labelledby="cities-title">
    <div class="wrap grid">
      <p class="label" data-reveal>{t.cities.label}</p>
      <h2 id="cities-title" class="display cities-title" data-lines>
        <span class="line"><span set:html={rich(routeLine)} /></span>
      </h2>
      <div class="right-wide route" data-route aria-hidden="true">
        <Dots />
        <div class="route-names">
          {cityPos.map((c) => <span class="label" style={`--pos:${c.pos}`}>{c.name}</span>)}
        </div>
        <p class="intro more">{t.cities.more}</p>
      </div>
    </div>
  </section>

  <!-- 6 · HOW TO JOIN -->
  <section id="join" class="section join" aria-labelledby="join-title">
    <div class="wrap grid">
      <h2 id="join-title" class="label" data-reveal>{t.join.label}</h2>
      <ol class="steps">
        {t.join.steps.map((s: { name: string; line: string }, i: number) => (
          <li class="step" data-reveal>
            <span class="num step-num">{pad(i + 1)}</span>
            <h3 class="step-name">{s.name}</h3>
            <p>{s.line}</p>
          </li>
        ))}
      </ol>
      <div class="join-close">
        <Heading as="p" lines={t.join.lines} size={2} class="join-line" />
        <a class="circle-button join-apply" href={link('/apply/')} data-reveal>{t.join.cta}</a>
      </div>
    </div>
  </section>

  <!-- 7 · PARTNERS -->
  <section id="partners" class="section partners" aria-labelledby="partners-title">
    <div class="wrap grid">
      <p class="label" data-reveal>{t.partners.label}</p>
      <Heading id="partners-title" lines={t.partners.lines} size={2} class="partners-title" />
      <div class="right partners-body">
        <ul class="types">
          {t.partners.types.map((p: { name: string; line: string }) => (
            <li data-reveal>
              <h3 class="label">{p.name}</h3>
              <p>{p.line}</p>
            </li>
          ))}
        </ul>
        <a class="link is-underlined partners-cta" href={link('/partners/')} data-reveal>{t.partners.cta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .label { margin-bottom: clamp(1.25rem, 3vw, 2rem); }

  /* 1 · Hero */
  .hero { padding-top: calc(var(--header-h) + clamp(2rem, 6vw, 4rem)); }
  .hero :global(.hero-title) { color: var(--salvia); }
  .hero-intro { grid-column: 3 / -1; margin-top: clamp(2.5rem, 6vw, 4.5rem); }
  .hero-photo { grid-column: 1 / -1; margin-top: clamp(2rem, 4vw, 2.5rem); overflow: hidden; }
  .hero-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }

  /* 2 · Circle */
  .circle-text { margin-top: clamp(2.5rem, 6vw, 4.5rem); display: grid; gap: 2rem; }
  .lead { font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem); line-height: 1.45; max-width: 30ch; }
  .values { margin: 0; line-height: 2; max-width: 34rem; }

  /* 3 · Experiences slider */
  .experiences .wrap { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .slider { --offset: calc(var(--gutter) + (100vw - 2 * var(--gutter)) * 2 / 12); }
  .slides {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--offset);
    padding-inline: var(--offset) var(--gutter);
    scrollbar-width: none;
    cursor: grab;
  }
  .slides::-webkit-scrollbar { display: none; }
  .slides.is-dragging { cursor: grabbing; scroll-snap-type: none; }
  .slides.is-dragging * { pointer-events: none; }
  .card { flex: 0 0 clamp(15rem, 70vw, 23rem); scroll-snap-align: start; display: grid; align-content: start; gap: 0.4rem; user-select: none; }
  .card-photo { overflow: hidden; margin-bottom: 0.9rem; background: var(--areia); }
  .card-photo img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; transition: transform 0.9s var(--ease); }
  .card:hover .card-photo img { transform: scale(1.04); }
  .card-num { font-size: var(--size-label); letter-spacing: 0.1em; }
  .card-name { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem); line-height: 1; }
  .card-line { max-width: 28ch; }
  .card.no-img { border-top: 1px solid var(--noite); padding-top: 1rem; }
  .slider-nav { display: flex; gap: 0.5rem; padding-left: var(--offset); margin-top: 1.75rem; }
  .arrow {
    width: 3rem; height: 3rem;
    border: 0; background: none; color: var(--noite);
    font: 400 1.6rem / 1 var(--font-body);
    cursor: pointer;
    transition: transform 0.3s var(--ease), opacity 0.3s ease;
  }
  .arrow:hover { transform: translateX(var(--nudge, 0)); }
  [data-prev] { --nudge: -4px; }
  [data-next] { --nudge: 4px; }
  .slider-nav[hidden] { display: none; }
  .arrow:disabled { opacity: 0.25; cursor: default; transform: none; }

  /* 4 · Agenda: heading, collage of two photos, list rows */
  .agenda-head { grid-column: 1 / -1; }
  .pic { overflow: hidden; }
  .pic img { width: 100%; object-fit: cover; }
  .pic-high { grid-column: 5 / -1; margin-top: 2.5rem; }
  .pic-high img { aspect-ratio: 3 / 4; }
  .pic-low { grid-column: 1 / span 9; margin-top: 1.5rem; }
  .pic-low img { aspect-ratio: 4 / 3; }
  .agenda-list { margin-top: clamp(3rem, 7vw, 5rem); }
  .rows { border-top: 1px solid var(--noite); }
  .row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.25rem 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--noite);
  }
  .row-date { font-size: 1.05rem; padding-top: 0.35rem; }
  .row-format { font-family: var(--font-display); font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.8rem); line-height: 1; }
  .row-ed { font-family: var(--font-black); font-size: var(--size-label); letter-spacing: 0.12em; vertical-align: middle; }
  .row-meta { grid-column: 2; display: grid; gap: 0.1rem; font-size: 0.9rem; }
  .empty { font-family: var(--font-display); font-size: clamp(2.4rem, 1.6rem + 3vw, 4.4rem); line-height: 1; padding-block: 1.5rem; border-block: 1px solid var(--noite); }
  .follow { margin-top: 1.75rem; font-size: 0.95rem; }

  @media (min-width: 48rem) {
    .hero-intro { grid-column: 5 / span 4; }
    .hero-photo { grid-column: 5 / -1; }
    .hero-photo img { aspect-ratio: 16 / 11; }
    .agenda-head { grid-column: 1 / span 6; grid-row: 1; }
    .pic-high { grid-column: 8 / span 4; grid-row: 1 / span 2; margin-top: 8rem; }
    .pic-low { grid-column: 1 / span 5; grid-row: 2; margin-top: 6rem; }
    .row { grid-template-columns: 6rem minmax(0, 1.3fr) minmax(0, 1fr); align-items: baseline; padding-block: 1.6rem; }
    .row-meta { grid-column: 3; }
  }

  /* 5 · Cities */
  .cities-title { grid-column: 1 / -1; }
  .cities-title :global(span) { white-space: normal; }
  .route { margin-top: clamp(2.5rem, 6vw, 4rem); --dot: var(--lima); }
  .route :global(.dot) { box-shadow: inset 0 0 0 1px var(--noite); }
  .route-names { position: relative; height: 1.5rem; margin-top: 0.9rem; }
  .route-names span {
    position: absolute;
    left: calc(var(--pos) / 6 * 100%);
    transform: translateX(calc(var(--pos) / 6 * -100%));
    white-space: nowrap;
    margin: 0;
  }
  .more { margin-top: 2rem; }

  /* 6 · Join */
  .steps { display: grid; gap: 2rem; }
  .step { display: grid; gap: 0.4rem; padding-top: 1.25rem; border-top: 1px solid var(--noite); }
  .step-num { font-size: 1.6rem; line-height: 1; margin-bottom: 0.9rem; }
  .step-name { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.8rem, 1.4rem + 1.2vw, 2.5rem); line-height: 1; }
  .join-close { margin-top: clamp(4rem, 10vw, 8rem); display: grid; gap: 2rem; justify-items: start; }
  .join-apply { --circle: 7.5rem; }
  @media (min-width: 48rem) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--col-gap); }
    .join-close { grid-template-columns: 1fr auto; align-items: end; }
    .join-apply { --circle: 9rem; }
  }

  /* 7 · Partners */
  .partners-body { margin-top: clamp(2.5rem, 6vw, 4rem); display: grid; gap: 2rem; justify-items: start; }
  .types { width: 100%; border-top: 1px solid var(--noite); }
  .types li { display: grid; gap: 0.25rem; padding-block: 1.1rem; border-bottom: 1px solid var(--noite); }
  .types .label { margin: 0; }
  .partners-cta { font-family: var(--font-display); font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem); line-height: 1.1; }
  @media (min-width: 48rem) {
    .types li { grid-template-columns: 9rem 1fr; align-items: baseline; }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import { copy, link } from '../../lib/content';
const p = copy('en').partner_form;
---
<Base title={`${p.thanks_title} · Seven Hills`} noindex>
  <section class="page">
    <div class="wrap thanks">
      <p class="label">{p.label}</p>
      <h1 class="page-title">{p.thanks_title}</h1>
      <p>{p.thanks}</p>
      <a class="cta" href={link('/')}>{p.back}</a>
    </div>
  </section>
</Base>

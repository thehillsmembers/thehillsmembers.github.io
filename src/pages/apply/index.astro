---
import Base from '../../layouts/Base.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import { copy } from '../../lib/content';
const a = copy('en').apply;
---
<Base title={a.meta_title} description={a.meta_description}>
  <section class="page">
    <div class="wrap">
      <div class="page-head">
        <p class="label">{a.label}</p>
        <h1 class="page-title">{a.title}</h1>
        <p class="accent">{a.intro}</p>
        <p class="hint">{a.required_note}</p>
      </div>
      <ApplyForm />
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import { copy, link } from '../lib/content';
const n = copy('en').not_found;
---
<Base title={n.meta_title} noindex>
  <section class="page">
    <div class="wrap thanks">
      <p class="label">{n.label}</p>
      <h1 class="page-title">{n.title}</h1>
      <p>{n.line}</p>
      <a class="cta" href={link('/')}>{n.cta}</a>
    </div>
  </section>
</Base>
